---
// src/pages/historias/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// 1. Obtener el slug de la URL
const { slug } = Astro.params;

// 2. Buscar en la base de datos
const { data: historia, error } = await supabase
  .from('historias')
  .select('*')
  .eq('slug', slug)
  .single(); // .single() devuelve un solo objeto, no un array

// 3. Manejar si no existe (404)
if (!historia || error) {
  return Astro.redirect('/404');
}
---

<Layout title={historia.titulo}>
  <main class="container mx-auto px-4 py-16 max-w-3xl">
    <h1 class="text-5xl font-playfair font-bold text-green-900 mb-6">{historia.titulo}</h1>
    
    <div class="text-gray-500 mb-8 flex gap-4 text-sm">
        <span>{new Date(historia.fecha).toLocaleDateString()}</span>
        <span>Autoria: {historia.creditos}</span>
    </div>

    <article class="prose prose-lg text-gray-700 leading-relaxed whitespace-pre-wrap">
        {historia.contenido}
    </article>
    
    <a href="/historias" class="inline-block mt-12 text-green-700 hover:underline">← Volver a historias</a>
  </main>
</Layout>