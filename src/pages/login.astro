---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

let errorMsg = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get("email")?.toString();
    const password = formData.get("password")?.toString();

    if (!email || !password) {
      errorMsg = "Por favor completa todos los campos.";
    } else {
      // 1. Intentar iniciar sesión con Supabase
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorMsg = "Credenciales incorrectas.";
      } else {
        // 2. Si es correcto, guardar los tokens en Cookies
        const { access_token, refresh_token } = data.session;
        
        Astro.cookies.set("sb-access-token", access_token, {
          path: "/",
          httpOnly: true, // Más seguro, JS no puede leerlo
          secure: true,   // Solo funciona en HTTPS (o localhost)
        });
        
        Astro.cookies.set("sb-refresh-token", refresh_token, {
          path: "/",
          httpOnly: true,
          secure: true,
        });

        // 3. Redirigir al inicio o a historias
        return Astro.redirect("/historias");
      }
    }
  } catch (e) {
    errorMsg = "Ocurrió un error inesperado.";
  }
}
---

<Layout title="Acceso Administrador">
  <div class="min-h-[70vh] flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-md border border-gray-200">
      <div>
        <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900 font-playfair">
          Acceso Administrador
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
          Escuela Pública Ruca Raqui
        </p>
      </div>
      
      <form class="mt-8 space-y-6" method="POST">
        {errorMsg && (
          <div class="bg-red-50 text-red-700 p-3 rounded-md text-sm text-center">
            {errorMsg}
          </div>
        )}
        
        <div class="rounded-md shadow-sm -space-y-px">
          <div>
            <label for="email-address" class="sr-only">Correo electrónico</label>
            <input id="email-address" name="email" type="email" required class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-green-500 focus:border-green-500 focus:z-10 sm:text-sm" placeholder="Correo electrónico">
          </div>
          <div>
            <label for="password" class="sr-only">Contraseña</label>
            <input id="password" name="password" type="password" required class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-green-500 focus:border-green-500 focus:z-10 sm:text-sm" placeholder="Contraseña">
          </div>
        </div>

        <div>
          <button type="submit" class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-green-700 hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors">
            Ingresar
          </button>
        </div>
      </form>
      
      <div class="text-center mt-4">
        <a href="/" class="text-sm text-green-600 hover:text-green-800">← Volver al inicio</a>
      </div>
    </div>
  </div>
</Layout>