---
// src/pages/glosario.astro
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// --- LÓGICA DE SERVIDOR (Igual que antes, no tocamos la funcionalidad) ---
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");
let isAdmin = false;

if (accessToken && refreshToken) {
  const { data, error } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  if (!error && data?.session) isAdmin = true;
}

if (Astro.request.method === "POST") {
    if (!isAdmin) return new Response("No autorizado", { status: 403 });
    try {
        const formData = await Astro.request.formData();
        const palabra = formData.get("palabra")?.toString().trim();
        const significado = formData.get("significado")?.toString().trim();
        const categoria = formData.get("categoria")?.toString();

        if (palabra && significado) {
            await supabase.from('glosario').insert({ palabra, significado, categoria });
        }
    } catch (error) { console.error(error); }
}

const { data: allPalabras } = await supabase
  .from('glosario')
  .select('*')
  .order('palabra', { ascending: true });

const categorias = allPalabras ? [...new Set(allPalabras.map(item => item.categoria).filter(Boolean))] : [];
---

<Layout title="Glosario - Sendero Pedagógico">

    {/* --- HERO SECTION PREMIUM --- */}
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0">
            {/* Imagen de fondo: Textura de tejido o naturaleza macro */}
            <Image
                src="https://images.unsplash.com/photo-1618458345651-f16fb265da9f?q=80&w=1972&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" 
                alt="Textura natural" 
                inferSize={true}
                class="w-full h-full object-cover opacity-80"
                decoding="async"
                loading="lazy"
                format ='avif'
            />
            <div class="absolute inset-0 bg-gradient-to-b from-green-950/90 via-green-900/80 to-stone-50"></div>
        </div>

        <div class="relative z-10 container mx-auto px-4 text-center mt-10">
            <span class="inline-block py-1 px-3 rounded-full bg-white/10 border border-white/20 text-amber-200 text-xs font-bold tracking-widest mb-6 backdrop-blur-sm">
                SABIDURÍA ANCESTRAL
            </span>
            <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 font-playfair drop-shadow-lg">
                Glosario <span class="text-amber-400 italic">Mapuche</span>
            </h1>
            <p class="text-xl text-green-100 max-w-2xl mx-auto font-light leading-relaxed">
                Cada palabra es un universo. Descubre los conceptos profundos que conectan nuestra lengua con el territorio y el espíritu.
            </p>
        </div>
        
        {/* Separador SVG */}
        <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] text-stone-50">
            <svg class="relative block w-[calc(100%+1.3px)] h-[50px] md:h-[80px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M1200 120L0 16.48 0 0 1200 0 1200 120z" class="fill-stone-50"></path>
            </svg>
        </div>
    </section>

    {/* --- PANEL ADMIN (Solo si es admin) --- */}
    {isAdmin && (
        <section class="container mx-auto px-4 -mt-10 relative z-20 mb-16">
            <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-green-100 max-w-4xl mx-auto">
                <div class="flex items-center gap-4 mb-6 border-b border-gray-100 pb-4">
                    <div class="bg-green-100 p-3 rounded-full text-green-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-green-900">Agregar Nuevo Término</h3>
                        <p class="text-sm text-gray-500">Panel de Administrador</p>
                    </div>
                </div>
                
                <form method="POST" class="grid gap-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Palabra</label>
                            <input required type="text" name="palabra" class="w-full rounded-xl bg-gray-50 border-transparent focus:border-green-500 focus:bg-white focus:ring-0 transition-all p-3 font-playfair font-bold text-lg text-green-900" placeholder="Ej: Küme Mogen">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Categoría</label>
                            <select name="categoria" class="w-full rounded-xl bg-gray-50 border-transparent focus:border-green-500 focus:bg-white focus:ring-0 transition-all p-3">
                                <option value="Cosmovisión">Cosmovisión</option>
                                <option value="Naturaleza">Naturaleza</option>
                                <option value="Ceremonial">Ceremonial</option>
                                <option value="Social">Social</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Significado</label>
                        <textarea required name="significado" rows="2" class="w-full rounded-xl bg-gray-50 border-transparent focus:border-green-500 focus:bg-white focus:ring-0 transition-all p-3 text-gray-700 leading-relaxed"></textarea>
                    </div>
                    <button type="submit" class="bg-green-700 hover:bg-green-800 text-white font-bold py-3 px-8 rounded-xl w-full transition-transform hover:-translate-y-1 shadow-lg">Guardar</button>
                </form>
            </div>
        </section>
    )}

    {/* --- LISTADO DE PALABRAS --- */}
    <main class="container mx-auto px-4 py-12 bg-stone-50 min-h-[60vh]">
        
        {/* Filtros visuales (Chips) */}
        {categorias.length > 0 && (
            <div class="flex flex-wrap justify-center gap-2 mb-12">
                {categorias.map(cat => (
                    <span class="px-4 py-1.5 rounded-full bg-white border border-stone-200 text-stone-600 text-sm font-medium shadow-sm">
                        {cat}
                    </span>
                ))}
            </div>
        )}

        {allPalabras && allPalabras.length > 0 ? (
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
                {allPalabras.map((item) => (
                    <article class="group bg-white p-8 rounded-[2rem] shadow-sm hover:shadow-xl hover:shadow-green-900/5 transition-all duration-300 border border-stone-100 hover:border-green-200 relative overflow-hidden">
                        
                        {/* Letra Capital decorativa de fondo */}
                        <span class="absolute -right-4 -top-6 text-[10rem] font-serif text-stone-50 font-bold select-none group-hover:text-green-50 transition-colors">
                            {item.palabra.charAt(0)}
                        </span>

                        <div class="relative z-10">
                            {item.categoria && (
                                <span class="inline-block px-3 py-1 rounded-lg bg-green-50 text-green-800 text-[10px] font-bold tracking-widest uppercase mb-3">
                                    {item.categoria}
                                </span>
                            )}
                            
                            <h2 class="text-3xl font-bold text-green-950 mb-4 font-playfair group-hover:text-amber-600 transition-colors">
                                {item.palabra}
                            </h2>
                            
                            <p class="text-stone-600 leading-relaxed text-lg">
                                {item.significado}
                            </p>
                        </div>
                    </article>
                ))}
            </div>
        ) : (
            <div class="text-center py-20 opacity-50">
                <p class="text-xl font-playfair italic">El diccionario está esperando sus primeras palabras...</p>
            </div>
        )}
    </main>

</Layout>