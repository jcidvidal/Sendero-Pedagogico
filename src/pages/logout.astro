---
// src/pages/logout.astro
import { supabase } from '../lib/supabase';

// 1. Cerrar sesión en Supabase (Opcional, pero buena práctica)
await supabase.auth.signOut();

// 2. BORRAR LAS COOKIES (Lo más importante)
// Es vital que el 'path' sea "/" para que se borren en todo el sitio
Astro.cookies.delete("sb-access-token", { path: "/" });
Astro.cookies.delete("sb-refresh-token", { path: "/" });

// 3. Redirigir al inicio (o a donde prefieras)
return Astro.redirect("/");
---