---
// src/pages/historias.astro
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import StoryCard from '../components/StoryCard.astro';

// --- 1. VERIFICACIÓN DE ADMIN (SEGURIDAD) ---
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");
let isAdmin = false;

if (accessToken && refreshToken) {
  const { data, error } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  
  if (!error && data?.session) {
    isAdmin = true;
  }
}

// --- 2. LÓGICA DEL SERVIDOR (POST - GUARDAR HISTORIA) ---
if (Astro.request.method === "POST") {
  if (!isAdmin) {
    return new Response("No autorizado", { status: 403 });
  }

  try {
    const formData = await Astro.request.formData();
    
    const titulo = formData.get("titulo")?.toString() || "";
    const resumen = formData.get("resumen")?.toString() || "";
    const contenido = formData.get("contenido")?.toString() || "";
    const creditos = formData.get("creditos")?.toString() || "";
    const fecha = formData.get("fecha")?.toString() || new Date().toISOString();
    
    // --- SUBIDA DE IMAGEN ---
    const imagenFile = formData.get("imagen");
    let coverUrl = null;

    if (imagenFile && imagenFile instanceof File && imagenFile.size > 0) {
        const fileExt = imagenFile.name.split('.').pop();
        const fileName = `${Date.now()}-${Math.random().toString(36).substring(2)}.${fileExt}`;
        const filePath = `historias/${fileName}`;

        const { error: uploadError } = await supabase.storage
            .from('imagenes')
            .upload(filePath, imagenFile);

        if (uploadError) {
            console.error("Error subiendo imagen:", uploadError);
        } else {
            const { data: publicUrlData } = supabase.storage
                .from('imagenes')
                .getPublicUrl(filePath);
            coverUrl = publicUrlData.publicUrl;
        }
    }

    const slug = titulo.toLowerCase().trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');

    const { error } = await supabase
      .from('historias')
      .insert({ 
        titulo, 
        slug, 
        resumen, 
        contenido, 
        creditos, 
        fecha,
        cover: coverUrl 
      });

    if (error) {
        console.error("Error DB:", error);
    } 
    // Éxito: La página se recargará automáticamente al terminar el POST

  } catch (error) {
    console.error("Error general:", error);
  }
}

// --- 3. OBTENER HISTORIAS (GET - PARA TODOS) ---
const { data: allHistorias } = await supabase
  .from('historias')
  .select('*')
  .order('fecha', { ascending: false });
---

<Layout title="Historias y Relatos - Sendero Pedagógico">
    
    {/* HERO SECTION */}
    <section class="bg-gradient-to-r from-emerald-900 to-green-800 py-24 relative overflow-hidden">
        {/* Patrón de fondo sutil */}
        <div class="absolute inset-0 opacity-35 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
        
        <div class="container mx-auto px-4 text-center text-white relative z-10">
            <span class="inline-block py-1 px-3 rounded-full bg-white/10 border border-white/20 text-green-100 text-xs font-bold tracking-widest mb-4 backdrop-blur-sm">
                MEMORIA VIVA
            </span>
            <h1 class="text-5xl md:text-6xl font-bold mb-6 font-playfair drop-shadow-md">
                Historias y Relatos
            </h1>
            <div class="w-24 h-1 bg-amber-400 mx-auto mb-6 rounded-full"></div>
            <p class="text-xl max-w-3xl mx-auto opacity-90 font-light leading-relaxed text-green-50">
                Conoce las voces del territorio, los saberes ancestrales y las vivencias que tejen la identidad de nuestra comunidad.
            </p>
        </div>
    </section>

    {/* --- FORMULARIO SOLO PARA ADMIN --- */}
    {isAdmin && (
        <section class="container mx-auto px-4 py-12 -mt-8 relative z-20">
            <div class="bg-white p-8 rounded-3xl border border-green-100 shadow-xl max-w-4xl mx-auto border-l-8 border-l-green-600">
                <div class="flex justify-between items-center mb-8 border-b border-gray-100 pb-4">
                    <div>
                        <h3 class="text-2xl font-bold text-green-900 font-playfair">🛠️ Panel de Editor</h3>
                        <p class="text-sm text-gray-500">Agrega una nueva historia al repositorio.</p>
                    </div>
                    <span class="text-xs bg-green-100 text-green-800 px-3 py-1 rounded-full font-bold border border-green-200">SESIÓN ACTIVA</span>
                </div>
                
                <form method="POST" enctype="multipart/form-data" class="grid gap-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-2">Título</label>
                            <input required type="text" name="titulo" class="w-full rounded-xl border border-gray-200 bg-gray-50 p-3 focus:ring-2 focus:ring-green-500 focus:bg-white transition-colors outline-none" placeholder="Ej: El Nguillatun">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-2">Fecha</label>
                            <input required type="date" name="fecha" class="w-full rounded-xl border border-gray-200 bg-gray-50 p-3 focus:ring-2 focus:ring-green-500 outline-none">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Imagen de Portada</label>
                        <div class="flex items-center justify-center w-full">
                            <label for="dropzone-file" class="flex flex-col items-center justify-center w-full h-32 border-2 border-green-300 border-dashed rounded-xl cursor-pointer bg-green-50 hover:bg-green-100 transition-colors group">
                                <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                    <svg class="w-8 h-8 mb-2 text-green-400 group-hover:text-green-600 transition-colors" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
                                    </svg>
                                    <p class="text-sm text-gray-500"><span class="font-semibold text-green-700">Clic para subir imagen</span> o arrastrar y soltar</p>
                                    <p class="text-xs text-gray-400">SVG, PNG, JPG or WEBP</p>
                                </div>
                                <input id="dropzone-file" type="file" name="imagen" accept="image/*" class="hidden" />
                            </label>
                        </div> 
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Resumen Corto</label>
                        <textarea required name="resumen" rows="2" class="w-full rounded-xl border border-gray-200 bg-gray-50 p-3 focus:ring-2 focus:ring-green-500 outline-none transition-all" placeholder="Aparecerá en la tarjeta de presentación..."></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Contenido Completo</label>
                        <textarea required name="contenido" rows="10" class="w-full rounded-xl border border-gray-200 bg-gray-50 p-3 focus:ring-2 focus:ring-green-500 outline-none transition-all" placeholder="Escribe aquí toda la historia..."></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Créditos / Autoría</label>
                        <input type="text" name="creditos" class="w-full rounded-xl border border-gray-200 bg-gray-50 p-3 outline-none focus:ring-2 focus:ring-green-500 transition-all" placeholder="Ej: Relato de la comunidad">
                    </div>

                    <div class="flex justify-end gap-4 pt-4 border-t border-gray-100">
                        <button type="reset" class="px-6 py-2 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 font-medium transition-colors">Cancelar</button>
                        <button type="submit" class="bg-green-700 hover:bg-green-800 text-white font-bold py-3 px-8 rounded-xl transition-all shadow-lg hover:shadow-green-900/20 hover:-translate-y-1">
                            Publicar Historia
                        </button>
                    </div>
                </form>
            </div>
        </section>
    )}

    {/* --- LISTADO DE HISTORIAS --- */}
    <section class="py-24 bg-stone-50 min-h-[60vh]">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
                
                {allHistorias && allHistorias.length > 0 ? (
                    allHistorias.map((historia) => (
                        <StoryCard 
                            titulo={historia.titulo}
                            resumen={historia.resumen}
                            fecha={historia.fecha}
                            cover={historia.cover}
                            slug={historia.slug}
                            creditos={historia.creditos}
                        />
                    ))
                ) : (
                    <div class="col-span-full py-20 text-center">
                        <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm border border-gray-100">
                            <span class="text-4xl grayscale opacity-40">📭</span>
                        </div>
                        <h3 class="text-xl font-medium text-stone-800">Aún no hay historias</h3>
                        <p class="text-stone-500 mt-2">Pronto compartiremos los relatos de nuestra comunidad.</p>
                    </div>
                )}

            </div>
        </div>
    </section>

</Layout>