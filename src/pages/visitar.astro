---
// src/pages/visitar.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Planifica tu Visita">

    {/* HERO */}
    <section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0">
            <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?q=80&w=2000&auto=format&fit=crop" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-green-950/70"></div>
        </div>
        <div class="relative z-10 text-center text-white container mx-auto px-4">
            <h1 class="text-5xl md:text-7xl font-bold font-playfair mb-4">Ven al Sendero</h1>
            <p class="text-xl opacity-90 font-light">Escuela Pública Ruca Raqui, Isla Huapi</p>
        </div>
        {/* Separador */}
        <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] text-stone-50">
            <svg class="relative block w-[calc(100%+1.3px)] h-[50px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M1200 120L0 16.48 0 0 1200 0 1200 120z" class="fill-stone-50"></path>
            </svg>
        </div>
    </section>

    <main class="bg-stone-50 py-20">
        <div class="container mx-auto px-4">
            <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12">
                
                {/* COLUMNA IZQUIERDA: Info Práctica */}
                <div class="space-y-8">
                    <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-stone-100">
                        <h2 class="text-3xl font-bold text-green-900 font-playfair mb-6 flex items-center gap-3">
                            <span class="text-amber-500">📍</span> Cómo Llegar
                        </h2>
                        <p class="text-stone-600 mb-6 leading-relaxed">
                            Nos ubicamos en la comunidad de Anüweyeco, en el corazón de Isla Huapi, comuna de Saavedra. El acceso es a través de un entorno privilegiado rodeado por el Lago Budi.
                        </p>
                        <div class="aspect-video bg-gray-200 rounded-xl overflow-hidden relative group">
                            {/* Aquí iría el iframe de Google Maps real */}
                            <div class="absolute inset-0 flex items-center justify-center bg-stone-200 text-stone-400 font-bold group-hover:bg-stone-300 transition-colors cursor-pointer">
                                MAPA INTERACTIVO
                            </div>
                        </div>
                    </div>

                    <div class="bg-green-900 text-white p-8 rounded-[2rem] shadow-lg relative overflow-hidden">
                        <div class="relative z-10">
                            <h3 class="text-2xl font-bold font-playfair mb-4">Horarios de Visita</h3>
                            <ul class="space-y-4">
                                <li class="flex justify-between border-b border-green-700 pb-2">
                                    <span>Lunes a Viernes</span>
                                    <span class="font-bold text-amber-300">09:00 - 17:00</span>
                                </li>
                                <li class="flex justify-between border-b border-green-700 pb-2">
                                    <span>Sábados</span>
                                    <span class="font-bold text-amber-300">10:00 - 14:00</span>
                                </li>
                                <li class="flex justify-between text-green-300 pt-2">
                                    <span>Domingos y Festivos</span>
                                    <span>Cerrado</span>
                                </li>
                            </ul>
                        </div>
                        {/* Decoración */}
                        <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-green-800 rounded-full blur-3xl opacity-50"></div>
                    </div>
                </div>

                {/* COLUMNA DERECHA: Recomendaciones */}
                <div class="space-y-8">
                    <h2 class="text-4xl font-bold text-green-900 font-playfair mb-8">Prepara tu mochila</h2>
                    
                    <div class="grid gap-6">
                        {/* Item 1 */}
                        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-stone-100 hover:border-green-200 transition-colors">
                            <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center text-2xl flex-shrink-0">👟</div>
                            <div>
                                <h3 class="font-bold text-lg text-green-900">Calzado Cómodo</h3>
                                <p class="text-stone-500 text-sm">El sendero tiene tramos de tierra y humedad. Usa zapatillas con buen agarre.</p>
                            </div>
                        </div>
                        {/* Item 2 */}
                        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-stone-100 hover:border-green-200 transition-colors">
                            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-2xl flex-shrink-0">💧</div>
                            <div>
                                <h3 class="font-bold text-lg text-green-900">Hidratación</h3>
                                <p class="text-stone-500 text-sm">Lleva tu propia botella de agua reutilizable. ¡Evitamos el plástico!</p>
                            </div>
                        </div>
                        {/* Item 3 */}
                        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-stone-100 hover:border-green-200 transition-colors">
                            <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-2xl flex-shrink-0">📸</div>
                            <div>
                                <h3 class="font-bold text-lg text-green-900">Fotografía Responsable</h3>
                                <p class="text-stone-500 text-sm">Puedes tomar fotos, pero pide permiso si vas a fotografiar a personas de la comunidad.</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-amber-50 border border-amber-100 p-6 rounded-2xl mt-8">
                        <p class="text-amber-900 italic font-playfair text-lg text-center">
                            "Recuerda que entras a un espacio de aprendizaje y naturaleza viva. Tu respeto es la mejor ofrenda."
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </main>

</Layout>