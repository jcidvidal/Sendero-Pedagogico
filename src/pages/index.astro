---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
// import Header from '../components/Header.astro'; // Header ya suele estar en Layout, así que lo omito aquí para no duplicar.
---

<Layout title="Sendero Pedagógico - Escuela Pública Ruca Raqui">

  {/* --- 1. HERO SECTION PREMIUM --- */}
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    
    {/* A. Imagen de Fondo */}
    <div class="absolute inset-0 z-0">
        <img 
            src="/imagenes/index/Hero_Final.jpg"
            alt="Bosque nativo y humedal" 
            class="w-full h-full object-cover opacity-90"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-green-950/60 via-stone-900/50 to-stone-900/90"></div>
    </div>

    {/* C. Contenido Principal */}
    <div class="relative z-10 container mx-auto px-4 text-center mt-10">
        
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-green-100 text-xs font-bold tracking-[0.2em] mb-8 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            ESCUELA PÚBLICA RUCA RAQUI
        </div>
        
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-6 font-playfair tracking-tight leading-none drop-shadow-2xl">
            Sendero <br class="md:hidden" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-200 via-white to-amber-100">
                Pedagógico
            </span>
        </h1>
        
        <div class="max-w-3xl mx-auto mb-10">
            <p class="text-xl md:text-3xl text-stone-200 font-light italic font-playfair leading-relaxed">
                "Wiño kimtuayin tañi rüpü, küll küll rüpül,<br/> mawizantu-menoko"
            </p>
            <div class="w-24 h-1 bg-amber-500 mx-auto mt-6 rounded-full shadow-[0_0_15px_rgba(245,158,11,0.5)]"></div>
            <p class="text-stone-300 mt-4 font-inter text-sm md:text-base tracking-wide uppercase opacity-80">
                Volvamos a conocer nuestro sendero-camino, bosque-humedal
            </p>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-5 justify-center items-center">
            <a href="/visitar" class="group relative px-8 py-4 bg-green-600 hover:bg-green-500 text-white font-bold rounded-full transition-all shadow-xl hover:shadow-green-500/30 hover:-translate-y-1 overflow-hidden">
                <span class="relative z-10 flex items-center gap-2">
                    Planificar Visita
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
                <div class="absolute top-0 -left-full w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent group-hover:animate-[shimmer_1.5s_infinite]"></div>
            </a>
            
            <a href="/historias" class="px-8 py-4 bg-white/5 hover:bg-white/10 backdrop-blur-md border border-white/30 text-white font-semibold rounded-full transition-all hover:-translate-y-1 hover:border-white/60">
                Leer Historias
            </a>
        </div>
    </div>

    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] text-stone-50">
        <svg class="relative block w-[calc(100%+1.3px)] h-[60px] md:h-[100px]" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M1200 120L0 16.48 0 0 1200 0 1200 120z" class="fill-stone-50"></path>
        </svg>
    </div>
  </section>

  {/* --- 2. SECCIÓN LA INSTITUCIÓN --- */}
  <section class="py-24 bg-stone-50 relative">
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-6xl mx-auto">
        
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold text-green-950 mb-4 font-playfair">Escuela Pública Ruca Raqui</h2>
            <div class="flex justify-center items-center gap-2">
                <span class="w-12 h-[1px] bg-green-800/30"></span>
                <span class="text-green-700 text-lg">❖</span>
                <span class="w-12 h-[1px] bg-green-800/30"></span>
            </div>
            <p class="text-lg text-stone-600 max-w-2xl mx-auto mt-6 leading-relaxed">
                Fundada el 16 de mayo de 1988 en Anüweyeco, Isla Huapi. Un espacio donde la identidad mapuche y la educación formal se abrazan junto al Lago Budi.
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="space-y-8">
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-stone-100 hover:shadow-md transition-shadow">
                <h3 class="text-2xl font-bold text-green-900 mb-3 font-playfair flex items-center gap-3">
                    <span class="text-amber-500 text-3xl">✦</span> Nuestra Historia
                </h3>
                <p class="text-stone-600 leading-relaxed">
                    Nacimos para dar respuesta a la necesidad educativa de la isla, honrando en nuestro nombre a la "Ruca Raqui" (Casa de las bandurrias), simbolizando la conexión entre escuela, bosque y lago.
                </p>
            </div>
          </div>

          <div class="bg-green-900 rounded-[2.5rem] p-8 md:p-12 text-white relative overflow-hidden shadow-2xl transform md:rotate-1 hover:rotate-0 transition-transform duration-500">
            <div class="absolute top-0 right-0 w-64 h-64 bg-green-800 rounded-full mix-blend-multiply filter blur-3xl opacity-50 -translate-y-1/2 translate-x-1/2"></div>
            
            <div class="relative z-10">
                <h3 class="text-3xl font-bold mb-6 font-playfair text-amber-300">Nuestro Propósito</h3>
                <p class="text-green-100 mb-6 text-lg leading-relaxed">
                Formar personas íntegras inspiradas en el <em class="text-white font-semibold not-italic">mapuche kimün</em>. Integramos los principios del:
                </p>
                <ul class="space-y-3">
                    <li class="flex items-center gap-3">
                        <span class="bg-amber-400 text-green-900 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">✓</span>
                        <span class="font-medium">Az Mapuche (Formación de persona)</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="bg-amber-400 text-green-900 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">✓</span>
                        <span class="font-medium">Filike Mogen (Convivencia)</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="bg-amber-400 text-green-900 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">✓</span>
                        <span class="font-medium">Küme Mogen (Buen vivir)</span>
                    </li>
                </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* --- 3. GALERÍA ENTORNO (Bento Grid con Lightbox) --- */}
  <section class="py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-green-950 mb-4 font-playfair">Nuestro Entorno</h2>
        <p class="text-stone-500">Haz clic en las imágenes para ampliarlas</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto h-auto md:h-[500px]">
        
        {/* 1. Imagen Grande (Izquierda) */}
        {/* AGREGADO: onclick="openModal(...)" */}
        <div 
            class="group relative md:col-span-2 md:row-span-2 overflow-hidden rounded-3xl shadow-lg cursor-zoom-in"
            onclick="openModal('/imagenes/index/Sendero.jpg', 'El Sendero')"
        >
          <div class="absolute inset-0">
             <img 
                src="/imagenes/index/Sendero.jpg" 
                alt="Sendero educativo" 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
             />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
          
          <div class="absolute bottom-8 left-8 text-white translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
            <h3 class="text-3xl font-playfair font-bold mb-2">El Sendero</h3>
            <p class="text-green-200 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">Conexión espiritual y educativa</p>
          </div>
        </div>

        {/* 2. Imagen Pequeña 1 (Derecha Arriba) */}
        <div 
            class="group relative overflow-hidden rounded-3xl shadow-lg h-64 md:h-auto cursor-zoom-in"
            onclick="openModal('/imagenes/index/Humedal.jpg', 'El Humedal')"
        >
          <div class="absolute inset-0">
            <img 
                src="/imagenes/index/Humedal.jpg" 
                alt="Humedal Lago Budi" 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
            />
          </div>
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"></div>
          <span class="absolute bottom-4 left-4 text-white font-bold text-lg drop-shadow-md">El Humedal</span>
        </div>

        {/* 3. Imagen Pequeña 2 (Derecha Abajo) */}
        <div 
            class="group relative overflow-hidden rounded-3xl shadow-lg h-64 md:h-auto cursor-zoom-in"
            onclick="openModal('/imagenes/index/aprendizaje.jpeg', 'Aprendizaje Vivo')"
        >
          <div class="absolute inset-0">
            <img 
                src="/imagenes/index/aprendizaje.jpeg" 
                alt="Estudiantes aprendiendo" 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
            />
          </div>
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"></div>
          <span class="absolute bottom-4 left-4 text-white font-bold text-lg drop-shadow-md">Aprendizaje Vivo</span>
        </div>

      </div>
    </div>
  </section>

  {/* --- 4. SECCIÓN VISIÓN --- */}
  <section id="vision" class="py-24 bg-stone-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/wood-pattern.png')]"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-bold mb-8 font-playfair text-amber-400">Nuestra Visión</h2>
        
        <div class="bg-white/5 border border-white/10 rounded-[2rem] p-10 md:p-14 backdrop-blur-sm relative">
          <span class="text-6xl text-green-500 absolute -top-6 -left-4 font-serif opacity-50">“</span>
          <p class="text-xl md:text-2xl leading-relaxed font-light text-stone-200">
            Aspiramos a ser reconocidos como una comunidad educativa de calidad, inclusiva e intercultural 
            en el contexto rural de la comuna de Saavedra, fundamentando nuestro quehacer en los principios 
            del <span class="text-amber-400 font-normal">Az Mapuche</span>, el <span class="text-amber-400 font-normal">Küme Mogen</span> y el <span class="text-amber-400 font-normal">Filike Mogen</span>.
          </p>
          <span class="text-6xl text-green-500 absolute -bottom-10 -right-4 font-serif opacity-50 transform rotate-180">“</span>
        </div>
      </div>
    </div>
  </section>

  {/* --- 5. CALL TO ACTION FINAL --- */}
  <section class="py-24 bg-green-50">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-green-900 mb-6 font-playfair">¿Listo para conectar con el territorio?</h2>
      <p class="text-lg text-stone-600 mb-10 max-w-2xl mx-auto">
        Antes de visitarnos, te invitamos a conocer nuestras normas para asegurar una experiencia respetuosa con el entorno y la comunidad.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/normas" class="px-8 py-4 bg-green-700 hover:bg-green-800 text-white font-bold rounded-xl transition-all shadow-lg hover:shadow-green-900/20 hover:-translate-y-1">
          Leer Normas del Sendero
        </a>
        <a href="/visitar" class="px-8 py-4 bg-white border border-green-200 text-green-800 font-bold rounded-xl hover:bg-green-50 transition-colors">
          Información de Visita
        </a>
      </div>
    </div>
  </section>

  {/* --- COMPONENTE LIGHTBOX (MODAL) --- */}
  <div id="imageModal" class="fixed inset-0 z-[60] hidden bg-black/90 backdrop-blur-sm transition-all duration-300 opacity-0" aria-hidden="true">
    
    {/* Botón cerrar */}
    <button onclick="closeModal()" class="absolute top-6 right-6 text-white/70 hover:text-white p-2 rounded-full hover:bg-white/10 transition-colors z-50">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    {/* Contenedor de la imagen */}
    <div class="flex items-center justify-center w-full h-full p-4" onclick="closeModal()">
        <img id="modalImage" src="" alt="" class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-300" onclick="event.stopPropagation()" />
        
        {/* Caption (Título de la foto) */}
        <p id="modalCaption" class="absolute bottom-8 left-0 w-full text-center text-white/90 font-playfair text-xl pointer-events-none"></p>
    </div>
  </div>

  {/* --- SCRIPT PARA EL MODAL --- */}
  <script is:inline>
    function openModal(src, alt) {
        const modal = document.getElementById('imageModal');
        const modalImg = document.getElementById('modalImage');
        const modalCaption = document.getElementById('modalCaption');

        // Configurar imagen
        modalImg.src = src;
        modalImg.alt = alt;
        modalCaption.textContent = alt;

        // Mostrar modal
        modal.classList.remove('hidden');
        // Pequeño delay para que la transición de opacidad funcione
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalImg.classList.remove('scale-95');
            modalImg.classList.add('scale-100');
        }, 10);
    }

    function closeModal() {
        const modal = document.getElementById('imageModal');
        const modalImg = document.getElementById('modalImage');

        // Ocultar con transición
        modal.classList.add('opacity-0');
        modalImg.classList.remove('scale-100');
        modalImg.classList.add('scale-95');

        setTimeout(() => {
            modal.classList.add('hidden');
            modalImg.src = ''; // Limpiar src para evitar flash al reabrir
        }, 300);
    }

    // Cerrar con la tecla ESC
    document.addEventListener('keydown', function(event) {
        if (event.key === "Escape") {
            closeModal();
        }
    });
  </script>

</Layout>