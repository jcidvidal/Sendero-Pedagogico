---
// src/pages/quienes-somos.astro
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Escuela from "../assets/quienes/Escuela.jpg";
import Escuela2 from "../assets/quienes/Escuela2.jpg";
import Patio from "../assets/quienes/Patio.jpg";
import Quienes from "../assets/quienes/quienes.jpg";
const pageTitle = "Quiénes Somos - Sendero Pedagógico";

export const prerender = true;
---

<Layout title={pageTitle}>
  
  {/* --- 1. HERO SECTION PREMIUM --- */}
  <section class="relative min-h-[65vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
        {/* Corrección de ruta: quitamos 'public' */}
        <Image 
            src={Quienes}
            alt="Educación Rural"
            class="w-full h-full object-cover opacity-90"
            inferSize={true}
            loading="lazy"
            decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-green-950/90 via-green-900/80 to-stone-50"></div>
    </div>

    <div class="relative z-10 container mx-auto px-4 text-center -top-5">
        <span class="inline-block py-1 px-3 rounded-full bg-white/10 border border-white/20 text-amber-200 text-xs font-bold tracking-widest mb-6 backdrop-blur-sm">
            NUESTRA ESENCIA
        </span>
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 font-playfair drop-shadow-lg leading-tight">
            Nuestra Institución <br/> <span class="text-amber-400 italic">y el Proyecto</span>
        </h1>
        <div class="w-24 h-1 bg-amber-500 mx-auto mb-8 rounded-full"></div>
        <p class="text-xl text-green-100 max-w-3xl mx-auto font-light leading-relaxed">
            Una visión educativa que integra el territorio, la identidad cultural Mapuche Lafkenche y la ciencia para la formación integral.
        </p>
    </div>
    
    {/* Separador SVG */}
    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] text-stone-50">
        <svg class="relative block w-[calc(100%+1.3px)] h-[60px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M1200 120L0 16.48 0 0 1200 0 1200 120z" class="fill-stone-50"></path>
        </svg>
    </div>
  </section>

  {/* --- 2. HISTORIA Y FUNDAMENTO --- */}
  <section class="py-24 bg-stone-50">
    <div class="container mx-auto px-4">
      <div class="max-w-7xl mx-auto">
        
        {/* Título de Sección */}
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-green-950 mb-4 font-playfair">
            Escuela Pública Ruca Raqui
          </h2>
          <p class="text-stone-500 text-lg">Un legado de educación y cultura en Isla Huapi</p>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-start">
          
          {/* COLUMNA IZQUIERDA: Texto Historia */}
          <div class="space-y-8">
            <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-stone-100">
                <h3 class="text-2xl font-bold text-green-900 mb-4 font-playfair flex items-center gap-3">
                    <span class="text-3xl">📖</span> Origen y Compromiso
                </h3>
                <p class="text-stone-600 mb-6 leading-relaxed text-lg">
                  La Escuela fue fundada el <strong class="text-green-700">16 de mayo de 1988</strong> en la comunidad
                  de <strong>Anüweyeco</strong>, Isla Huapi, comuna de Saavedra. Su creación
                  responde a la necesidad de entregar educación formal en un sector
                  rural con una profunda <strong>identidad mapuche</strong>.
                </p>
                <p class="text-stone-600 mb-8 leading-relaxed text-lg">
                  El nombre <strong>Ruca Raqui</strong>, que significa <em class="text-green-800 font-semibold">"Casa de las bandurrias"</em>, 
                  simboliza la conexión esencial entre el espacio educativo, el
                  bosque circundante y el lago Budi.
                </p>

                {/* Cita destacada */}
                <div class="bg-green-50 border-l-4 border-green-600 p-6 rounded-r-xl">
                    <p class="text-xl font-playfair italic text-green-900">"Wiño choyürayiletuy taiñ kimün"</p>
                    <p class="text-sm mt-2 text-green-700 font-bold uppercase tracking-wide">Volverá a brotar nuestro saber</p>
                </div>
            </div>
            
            {/* IMAGEN CLIQUEABLE (Lightbox Activado) */}
            <div 
                class="rounded-[2rem] overflow-hidden shadow-lg h-64 relative group cursor-zoom-in"
                onclick={`openModal('${Patio.src}', 'Escuela Ruca Raqui')`}
            >
                 <Image
                    src={Patio}
                    alt="Escuela Ruca Raqui"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    inferSize={true}
                    format="avif"
                    decoding="async"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-green-900/60 to-transparent pointer-events-none"></div>
                  <span class="absolute bottom-4 left-6 text-white font-bold text-lg pointer-events-none">Nuestra Escuela</span>
            </div>
          </div>

          {/* COLUMNA DERECHA: Tarjeta Propósito */}
          <div class="bg-green-900 text-white rounded-[2.5rem] p-10 md:p-12 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-green-800 rounded-full mix-blend-multiply filter blur-3xl opacity-50 -translate-y-1/2 translate-x-1/2"></div>
            
            <div class="relative z-10">
                <div class="w-16 h-16 bg-amber-400 rounded-full flex items-center justify-center text-3xl text-green-900 mb-8 shadow-lg">
                    🎯
                </div>
                
                <h3 class="text-3xl font-bold mb-6 font-playfair text-white">
                  Propósito y Filosofía
                </h3>
                
                <p class="text-green-100 mb-8 leading-relaxed text-lg border-b border-green-800 pb-8">
                  Nuestra misión es formar personas íntegras inspiradas en el <em class="text-amber-300 not-italic font-semibold">mapuche kimün</em>, 
                  promoviendo el desarrollo personal y comunitario basado en la autonomía, responsabilidad y el respeto mutuo.
                </p>
                
                <h4 class="text-amber-300 font-bold mb-4 uppercase tracking-widest text-sm">Pilares Fundamentales</h4>
                <ul class="space-y-4">
                    <li class="flex items-start gap-4">
                        <span class="bg-white/20 p-1 rounded text-amber-300 mt-1">✓</span>
                        <div>
                            <strong class="block text-white">Az Mapuche</strong>
                            <span class="text-green-200 text-sm">Formación de la persona</span>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="bg-white/20 p-1 rounded text-amber-300 mt-1">✓</span>
                        <div>
                            <strong class="block text-white">Fillke Mogen</strong>
                            <span class="text-green-200 text-sm">Convivencia armónica y biodiversidad</span>
                        </div>
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="bg-white/20 p-1 rounded text-amber-300 mt-1">✓</span>
                        <div>
                            <strong class="block text-white">Küme Mogen</strong>
                            <span class="text-green-200 text-sm">El Buen Vivir</span>
                        </div>
                    </li>
                </ul>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  {/* --- 3. SELLOS EDUCATIVOS --- */}
  <section class="py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-green-950 font-playfair">Sellos Educativos</h2>
            <div class="w-16 h-1 bg-green-500 mx-auto mt-4 rounded-full"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {/* Sello 1 */}
          <div class="group p-8 bg-stone-50 rounded-[2rem] border border-stone-100 hover:shadow-xl hover:bg-white hover:border-green-200 transition-all duration-300 hover:-translate-y-2">
            <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                🔬
            </div>
            <h3 class="text-xl font-bold text-green-900 mb-4 font-playfair">
              Aprendizaje Científico
            </h3>
            <p class="text-stone-600 leading-relaxed">
              Fomentamos la creatividad y resolución de problemas desde una <strong class="text-green-700">perspectiva científica</strong>, integrando rigurosamente los saberes ancestrales y contemporáneos.
            </p>
          </div>

          {/* Sello 2 */}
          <div class="group p-8 bg-stone-50 rounded-[2rem] border border-stone-100 hover:shadow-xl hover:bg-white hover:border-green-200 transition-all duration-300 hover:-translate-y-2">
            <div class="w-14 h-14 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                🌟
            </div>
            <h3 class="text-xl font-bold text-green-900 mb-4 font-playfair">
              Identidad Lafkenche
            </h3>
            <p class="text-stone-600 leading-relaxed">
              Promovemos el diálogo constructivo basado en la <strong class="text-green-700">identidad cultural Mapuche Lafkenche</strong>, logrando que estos valores sean herramientas vivas para la vida.
            </p>
          </div>

          {/* Sello 3 */}
          <div class="group p-8 bg-stone-50 rounded-[2rem] border border-stone-100 hover:shadow-xl hover:bg-white hover:border-green-200 transition-all duration-300 hover:-translate-y-2">
            <div class="w-14 h-14 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                🌱
            </div>
            <h3 class="text-xl font-bold text-green-900 mb-4 font-playfair">
              Bienestar Integral
            </h3>
            <p class="text-stone-600 leading-relaxed">
              Con foco en el <strong class="text-green-700">Küme Mogen</strong>, orientamos la formación para aportar activamente al bienestar social, cultural y ambiental sustentable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* --- 4. EQUIPO DE GESTIÓN --- */}
  <section class="py-24 bg-stone-900 text-white relative overflow-hidden">
     <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
     
     <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 font-playfair text-amber-400">
          Equipo de Gestión y Colaboradores
        </h2>
        
        <div class="bg-white/5 backdrop-blur-md rounded-3xl p-10 border border-white/10 shadow-2xl">
          <p class="text-xl text-stone-200 mb-8 leading-relaxed font-light">
            El Sendero Pedagógico es un proyecto impulsado por el <strong class="text-white font-bold">Equipo de Gestión y Convivencia Escolar de la Escuela Pública Ruca Raqui</strong>, 
            con la activa participación de la <strong class="text-white font-bold">Comunidad de Anüweyeco</strong>.
          </p>

          <div class="w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent my-8"></div>

          <p class="text-stone-400 italic">
            "Nuestra labor se fundamenta en la colaboración permanente con
            educadores tradicionales, autoridades ancestrales del territorio
            Lafkenche y diversas entidades académicas y culturales."
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* --- CTA FINAL --- */}
  <section class="py-24 bg-green-50">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-green-900 mb-6 font-playfair">
        ¿Listo para visitarnos?
      </h2>
      <p class="text-lg text-stone-600 mb-10 max-w-2xl mx-auto">
        Conoce nuestras normas y prepara tu visita al Sendero Pedagógico para
        una experiencia respetuosa y enriquecedora.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/normas"
          class="bg-green-700 hover:bg-green-800 text-white font-bold py-4 px-8 rounded-xl transition-all shadow-lg hover:shadow-green-900/20 hover:-translate-y-1"
        >
          Conocer Normas
        </a>
        <a
          href="/visitar"
          class="bg-white border border-green-200 text-green-800 hover:bg-green-50 font-bold py-4 px-8 rounded-xl transition-colors"
        >
          Planificar Visita
        </a>
      </div>
    </div>
  </section>

  {/* --- COMPONENTE LIGHTBOX (MODAL) --- */}
  <div id="imageModal" class="fixed inset-0 z-[60] hidden bg-black/90 backdrop-blur-sm transition-all duration-300 opacity-0" aria-hidden="true">
    
    {/* Botón cerrar */}
    <button onclick="closeModal()" class="absolute top-6 right-6 text-white/70 hover:text-white p-2 rounded-full hover:bg-white/10 transition-colors z-50">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    {/* Contenedor de la imagen */}
    <div class="flex items-center justify-center w-full h-full p-4" onclick="closeModal()">
        <img id="modalImage" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-300" onclick="event.stopPropagation()" />
        
        {/* Caption */}
        <p id="modalCaption" class="absolute bottom-8 left-0 w-full text-center text-white/90 font-playfair text-xl pointer-events-none"></p>
    </div>
  </div>

  {/* --- SCRIPT PARA EL MODAL --- */}
  <script is:inline>
    function openModal(src, alt) {
        const modal = document.getElementById('imageModal');
        const modalImg = document.getElementById('modalImage');
        const modalCaption = document.getElementById('modalCaption');

        modalImg.src = src;
        modalImg.alt = alt;
        modalCaption.textContent = alt;

        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalImg.classList.remove('scale-95');
            modalImg.classList.add('scale-100');
        }, 10);
    }

    function closeModal() {
        const modal = document.getElementById('imageModal');
        const modalImg = document.getElementById('modalImage');

        modal.classList.add('opacity-0');
        modalImg.classList.remove('scale-100');
        modalImg.classList.add('scale-95');

        setTimeout(() => {
            modal.classList.add('hidden');
            modalImg.src = ''; 
        }, 300);
    }

    document.addEventListener('keydown', function(event) {
        if (event.key === "Escape") {
            closeModal();
        }
    });
  </script>

</Layout>