---
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proyectos - Sendero Pedagógico</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white font-inter">
    <Header />

    <main class="container mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold text-center text-gray-800 mb-8 font-playfair">Proyectos</h1>
      <div class="max-w-3xl mx-auto text-lg text-gray-600">
        <p class="mb-6">
          Nuestros proyectos educativos y comunitarios...
        </p>
      </div>
    </main>

    <footer class="bg-gray-900 text-white py-12">
      <div class="container mx-auto px-4 text-center">
        <p class="text-lg mb-4 text-gray-300">Escuela Pública Ruca Raqui @ 2025</p>
        <div class="flex justify-center space-x-8 text-sm text-gray-400">
          <a href="#" class="hover:text-green-300 transition-colors duration-300">Eleven</a>
          <a href="#" class="hover:text-green-300 transition-colors duration-300">Twelve</a>
          <a href="#" class="hover:text-green-300 transition-colors duration-300">Thirteen</a>
          <a href="#" class="hover:text-green-300 transition-colors duration-300">Fourteen</a>
          <a href="#" class="hover:text-green-300 transition-colors duration-300">Fifteen</a>
        </div>
      </div>
    </footer>
  </body>
</html>