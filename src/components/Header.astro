---
// src/components/Header.astro
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/quienes-somos', label: 'Quiénes Somos' },
  { href: '/visitar', label: 'Visitar' },
  { href: '/historias', label: 'Historias' },
  { href: '/glosario', label: 'Glosario' },
  { href: '/normas', label: 'Normas' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/login', label: 'Admin 🔒' }
];

// Función con tipo explícito para evitar el error TypeScript
const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === href;
  }
  return currentPath.startsWith(href);
};
---

<header class="border-b border-gray-100 py-4 sticky top-0 z-50 backdrop-blur-sm bg-white/95">
  <nav class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
    <div class="text-2xl font-bold text-gray-800 font-playfair">
      Sendero Pedagógico
    </div>
    <div class="flex flex-wrap justify-center space-x-4 md:space-x-8">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`transition-colors font-medium ${
            isActive(item.href) 
              ? 'text-green-600 font-semibold border-b-2 border-green-600' 
              : 'text-gray-600 hover:text-green-600'
          }`}
        >
          {item.label}
        </a>
      ))}
    </div>
    <div class="text-sm text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
      +1234567890
    </div>
  </nav>
</header>