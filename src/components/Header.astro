---
// src/components/Header.astro
const currentPath = Astro.url.pathname;

// --- 1. DETECTAR SESIÓN ---
// Verificamos si existe la cookie de acceso de Supabase
const {isLoggedIn} = Astro.locals;

// --- 2. LISTA DE NAVEGACIÓN (Sin el botón de Admin) ---
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/quienes-somos', label: 'Quiénes Somos' },
  { href: '/visitar', label: 'Visitar' },
  { href: '/historias', label: 'Historias' },
  { href: '/glosario', label: 'Glosario' },
  { href: '/normas', label: 'Normas' },
  { href: '/proyectos', label: 'Proyectos' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === href;
  }
  return currentPath.startsWith(href);
};
---

<header class="border-b border-stone-200 py-4 sticky top-0 z-50 backdrop-blur-md bg-stone-50/90 transition-all duration-300">
  <nav class="container mx-auto px-4 flex flex-col lg:flex-row justify-between items-center space-y-4 lg:space-y-0">
    
    {/* --- LOGO --- */}
    <a href="/" class="text-2xl font-bold text-green-900 font-playfair flex items-center gap-2 group decoration-transparent">
        {/* Icono decorativo */}
        <span class="w-8 h-8 bg-amber-400 rounded-full flex items-center justify-center text-green-900 text-sm group-hover:scale-110 transition-transform shadow-sm">
            🌿
        </span>
        Sendero Pedagógico
    </a>

    {/* --- MENÚ DE NAVEGACIÓN --- */}
    <div class="flex flex-wrap justify-center items-center gap-1 md:gap-2">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`px-3 py-2 rounded-full text-sm font-medium transition-all duration-300 ${
            isActive(item.href) 
              ? 'bg-green-100 text-green-800 font-bold shadow-sm' 
              : 'text-stone-600 hover:text-green-700 hover:bg-stone-100'
          }`}
        >
          {item.label}
        </a>
      ))}
    </div>

    {/* --- BOTÓN DE SESIÓN (Dinámico) --- */}
    <div class="flex items-center" id="user-menu-container">
        
        {/* BOTÓN SALIR (Oculto por defecto con 'hidden', se activa por JS o SSR) */}
        <a 
            id="btn-logout"
            href="/logout" 
            class:list={[
                "flex items-center gap-2 px-4 py-2 bg-red-50 text-red-600 rounded-full text-xs font-bold hover:bg-red-100 transition-colors border border-red-100",
                !isLoggedIn ? "hidden" : "" // Si SSR dice que no, lo ocultamos base
            ]}
            title="Cerrar sesión"
        >
            <span>Salir</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
        </a>

        {/* BOTÓN LOGIN (Visible por defecto si no hay sesión SSR) */}
        <a 
            id="btn-login"
            href="/login" 
            class:list={[
                "group flex items-center gap-2 px-3 py-2 rounded-full text-stone-400 hover:text-green-700 hover:bg-green-50 transition-colors",
                isLoggedIn ? "hidden" : "" // Si SSR dice que sí, lo ocultamos base
            ]}
            aria-label="Acceso Administrador"
            title="Acceso Administrativo"
        >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </a>
    </div>

  </nav>
</header>

<script>
    // Script que se ejecuta en el cliente para corregir la UI en páginas estáticas
    // Usamos 'astro:page-load' para compatibilidad con ViewTransitions
    document.addEventListener('astro:page-load', () => {
        const btnLogout = document.getElementById('btn-logout');
        const btnLogin = document.getElementById('btn-login');

        // Función simple para leer cookies
        const getCookie = (name: string) => {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop()?.split(';').shift();
        };

        // Buscamos la cookie pública "is-logged-in"
        const isUserLoggedIn:boolean = getCookie('is-logged-in') === 'true';

        if (isUserLoggedIn) {
            // Usuario logueado: Mostrar Salir, Ocultar Login
            btnLogout?.classList.remove('hidden');
            btnLogin?.classList.add('hidden');
        } else {
            // Usuario anónimo: Mostrar Login, Ocultar Salir
            btnLogout?.classList.add('hidden');
            btnLogin?.classList.remove('hidden');
        }
    });
</script>